# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Used only by the controlled first-owner bootstrap in a later stage.
OWNER_BOOTSTRAP_SECRET=

# Set to a long random value when rate limiting / signed actions are added.
APP_ACTION_SECRET=
